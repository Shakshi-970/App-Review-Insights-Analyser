# Copy this file to .env for local development.
# On Railway: set each variable in the Railway dashboard (Variables tab).
# NEVER commit .env or credentials.json — both are in .gitignore.

# ── LLM ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
DEFAULT_MODEL=llama-3.3-70b-versatile

# ── Operation ─────────────────────────────────────────────────────────────────
# staging = create drafts / dry-run;  production = actually send
SEND_MODE=staging
TOKEN_BUDGET_PER_RUN=500000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///run_log.db

# ── Google Docs MCP Server ────────────────────────────────────────────────────
# Base64-encoded contents of your Google service-account credentials.json
# Get it with: python -c "import base64,pathlib; print(base64.b64encode(pathlib.Path('credentials.json').read_bytes()).decode())"
GOOGLE_CREDENTIALS_BASE64=your_base64_encoded_credentials_here

# The Google Doc ID where pulse reports are appended (from the Doc URL)
GOOGLE_DOCS_ID=your_google_doc_id_here

# Local stdio command (used when GOOGLE_DOCS_MCP_SERVER_URL is empty)
GOOGLE_DOCS_MCP_SERVER_COMMAND=python src/phase5_docs_mcp/server.py

# Deployed SSE URL — set this once the Docs MCP container is running
# GOOGLE_DOCS_MCP_SERVER_URL=https://your-docs-mcp.railway.app/sse

# ── Gmail MCP Server ──────────────────────────────────────────────────────────
SENDER_EMAIL=your_gmail@gmail.com

# Gmail App Password (not your account password)
# Create one at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your_gmail_app_password_here

RECIPIENT_EMAIL=recipient@example.com

# Local stdio command (used when GMAIL_MCP_SERVER_URL is empty)
GMAIL_MCP_SERVER_COMMAND=python src/phase6_gmail_mcp/server.py

# Deployed SSE URL — set this once the Gmail MCP container is running
# GMAIL_MCP_SERVER_URL=https://your-gmail-mcp.railway.app/sse
